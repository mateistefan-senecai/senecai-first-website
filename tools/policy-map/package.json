{
  "name": "senecai-policy-map",
  "private": true,
  "description": "Builds assets/policy-map.v1.{js,css} for global-ai-policy-map.html (ported from the old Next.js site).",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=../../assets/policy-map.v1.js && tailwindcss -c tailwind.config.js -i src/map.css -o ../../assets/policy-map.v1.css --minify"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "framer-motion": "^12.29.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^3.4.17"
  }
}
